POSTGRES_DB=aurexis
POSTGRES_USER=aurexis_user
POSTGRES_PASSWORD=CHANGE_ME

JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AUREXIS Chat (OpenAI-compatible provider)
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_TIMEOUT_SECONDS=75
CHAT_MAX_OUTPUT_TOKENS=1200
CHAT_CONTEXT_MESSAGES=20
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_TEMPERATURE=0.35

# --- WhatsApp phone verification (sign-up) -----------------------------------
# New users prove their phone by sending a pre-filled WhatsApp message; Meta
# delivers it to our webhook and we reply with a 6-digit code.
# Meta console -> WhatsApp -> Configuration -> Webhook:
#   Callback URL: https://<your-domain>/api/v1/auth/whatsapp/webhook
#   Verify token: WHATSAPP_VERIFY_TOKEN below; subscribe to the "messages" field.
# The business number, E.164 WITH "+" (wa.me reads 01xxxxxxxxx as another number).
WHATSAPP_NUMBER=
# The ID shown beside the number in the console, not the number itself.
WHATSAPP_PHONE_NUMBER_ID=
# System User token (whatsapp_business_messaging, never expires).
# Dashboard "temporary" tokens die within 24 hours (Meta error 190).
WHATSAPP_TOKEN=
WHATSAPP_GRAPH_VERSION=v22.0
# Any string you invent; type the same one into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
# App settings -> Basic -> App Secret. REQUIRED in production: unsigned webhooks are refused.
WHATSAPP_APP_SECRET=
WHATSAPP_CHALLENGE_TTL_MINUTES=10
SIGNUP_REQUIRE_PHONE=true
# Development only (Meta cannot reach localhost): lets the sign-up page
# simulate the WhatsApp message. Never enable where real users sign up.
WHATSAPP_DEV_SIMULATE=true
WHATSAPP_LOG_CODES=false
