APP_NAME=AUREXIS API
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@127.0.0.1:5432/DATABASE
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AUREXIS Chat (OpenAI-compatible provider)
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_TIMEOUT_SECONDS=75
CHAT_MAX_OUTPUT_TOKENS=1200
CHAT_CONTEXT_MESSAGES=20
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_TEMPERATURE=0.35
